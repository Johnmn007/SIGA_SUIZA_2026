# ============================================================
# Docker Compose - Variables de sustitucion
# Fuente de verdad de la configuracion de la BASE DE DATOS.
# La BD corre como contenedor "postgres" (servicio de docker-compose).
# ============================================================

# Credenciales del contenedor PostgreSQL.
DB_USER=postgres
DB_PASSWORD=john.007
DB_NAME=siga_core

# Puerto del host para conectarse con pgAdmin/DBeaver (5433 para no
# chocar con un PostgreSQL local que ya use el 5432).
DB_EXPOSED_PORT=5433

# Dump SQL que se restaura automaticamente la primera vez que se crea
# el volumen de la base de datos. Para restaurar de nuevo:
#   docker compose down -v && docker compose up -d
DB_INIT_DUMP=backup_siga_core_pre_reset_20261102.sql
