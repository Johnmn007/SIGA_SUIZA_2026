# ============================================================
# Variables de entorno para SIGA SUIZA 2026
# Fuente de verdad: configurar DATABASE_URL en Railway
# ============================================================

# Database - Priority: DATABASE_URL from Railway takes precedence
# Si Railway proporciona DATABASE_URL, se usará automáticamente.
# Si no está definida, los componentes abajo se usan como fallback para desarrollo.
DATABASE_URL=

# Component fallback (solo Development)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_suiza_2026

# Environment
ENVIRONMENT=development
DEBUG=True

# CORS - Origins permitidos para frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Puerto de la aplicación
PORT=8000

# NATS Event Bus
ENABLE_NATS=false
NATS_URL=nats://localhost:4222

# Redis Cache
CACHE_ENABLED=true
REDIS_URL=

# Security
SECRET_KEY=cambiar-esta-clave-en-produccion