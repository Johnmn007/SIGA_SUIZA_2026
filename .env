# ============================================================
# Docker Compose - Variables de substitucion
# Fuente de verdad de la configuracion de la BASE DE DATOS.
# La BD vive en el PostgreSQL local (pgAdmin), NO en el contenedor.
# ============================================================

# Host: dentro de un contenedor, "localhost" es el propio contenedor.
# "host.docker.internal" es el DNS que Docker Desktop provee para el host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=72720844
DB_NAME=siga_local
