# ============================================================
# Copia este archivo a ".env" y ajusta los valores.
# Docker Compose lee ".env" de la raiz para la substitucion de variables.
# ============================================================

# Credenciales del contenedor PostgreSQL (servicio "postgres").
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_core

# Puerto del host para pgAdmin/DBeaver (5433 evita chocar con un
# PostgreSQL local que ya use el 5432).
DB_EXPOSED_PORT=5433

# Dump SQL restaurado automaticamente al crear el volumen por primera vez.
DB_INIT_DUMP=backup_siga_core_pre_reset_20261102.sql
