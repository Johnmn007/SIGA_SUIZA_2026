# =============================================================================
# SIGA - Configuración de Docker Compose
# =============================================================================
# Copia este archivo a `.env` y rellena los valores.
#   Linux/macOS:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
#
# `.env` está ignorado por git. NUNCA lo subas al repositorio.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Usuario y nombre de la base que crea el contenedor de Postgres al inicializarse.
POSTGRES_USER=postgres
POSTGRES_DB=siga_core

# OBLIGATORIO. Sin valor, `docker compose up` falla al arrancar.
# Elige una contraseña propia. La que había en el repositorio se considera
# comprometida (estuvo versionada) y no debe reutilizarse.
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA

# Puerto en el host para conectarse a Postgres con pgAdmin/psql.
# Solo para depuración: en producción no debería publicarse.
POSTGRES_HOST_PORT=5432

# --- Seguridad del Core ------------------------------------------------------
# OBLIGATORIO. Clave con la que se firman TODOS los JWT.
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si cambia, todas las sesiones activas se invalidan.
SECRET_KEY=CAMBIA_ESTA_CLAVE_GENERANDO_UNA_ALEATORIA

# --- Entorno -----------------------------------------------------------------
# `development` habilita /docs, el log SQL y el sembrado de usuarios de prueba.
# Cualquier otro valor los deshabilita.
ENVIRONMENT=development
DEBUG=True

# --- Bus de eventos y caché --------------------------------------------------
ENABLE_NATS=True
CACHE_ENABLED=True

# --- Puertos publicados en el host -------------------------------------------
CORE_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# NOTA: los siete módulos (8001-8009) NO publican puerto en el host a propósito.
# Solo son accesibles a través del gateway en CORE_HOST_PORT. Para depurar uno
# directamente:  docker compose exec siga-core curl http://mod-usuarios:8001/health
