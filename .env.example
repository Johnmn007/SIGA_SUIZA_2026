# SIGA - Ejemplo de variables de entorno (raíz / Docker Compose)
# Copiar a .env y completar valores reales. NUNCA commitear el .env real.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-este-password
POSTGRES_DB=siga_core

# PostgreSQL NATIVO de Windows (visible en pgAdmin). Ya no corre en Docker.
# DB_HOST=host.docker.internal para los contenedores, localhost en pgAdmin.
DB_USER=postgres
DB_PASSWORD=cambiar-este-password
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=siga_core
SECRET_KEY=cambiar-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ENVIRONMENT=development
NATS_URL=nats://nats:4222
ENABLE_NATS=True
REDIS_URL=redis://redis:6379

# Frontend (build prod)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
