# ============================================================
# Copia este archivo a ".env" y ajusta los valores.
# Docker Compose lee ".env" de la raiz para la substitucion de variables.
# ============================================================

# PostgreSQL local (pgAdmin) = fuente de verdad de los datos.
# "host.docker.internal" es el hostname que Docker Desktop usa para
# alcanzar el host desde dentro de un contenedor.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_local
