# ============================================================
# Copia este archivo a ".env" y ajusta los valores.
# Docker Compose lee ".env" de la raiz para la substitucion de variables.
# ============================================================

# PostgreSQL dentro de docker-compose (servicio "postgres").
# Los contenedores se conectan al servicio por su nombre: DB_HOST=postgres.
# Para usar un PostgreSQL del host, cambia DB_HOST=host.docker.internal.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_core
