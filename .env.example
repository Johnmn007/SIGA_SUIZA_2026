# ==============================================
# Plantilla de variables compartidas del stack.
# Copiar a .env y completar los valores reales.
#   copy .env.example .env
# ==============================================

# --- Base de datos local (PostgreSQL de Windows, la misma que ves en pgAdmin) ---
# Desde dentro de los contenedores el host de la maquina es host.docker.internal
# (si ejecutas el backend sin Docker, usa localhost en su lugar)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=siga_core

# URL completa equivalente (referencia; la app arma la suya desde las vars de arriba)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/siga_core
