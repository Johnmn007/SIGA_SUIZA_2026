# Core Configuration
APP_NAME=SIGA Core
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True

# Database (Solo para Identity del Core)
# La base de datos es la local de PostgreSQL (siga_core). El password NO se
# versiona: en Docker Compose estas variables se inyectan desde el .env de la
# raiz del proyecto (ver .env.example) y tienen prioridad sobre este archivo.
# OJO: dentro de los contenedores el host de la maquina es host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=siga_core

# Module Discovery
MODULES_AUTO_DISCOVER=True
MODULES_VALIDATE_ON_START=True

# NATS Event Bus
NATS_URL=nats://localhost:4222
ENABLE_NATS=False  # Por ahora desactivado