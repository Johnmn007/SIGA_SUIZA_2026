# Variables para el servicio de Railway (configurar en el panel, no en este archivo).
APP_NAME=SIGA Core
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio

# Referencia al plugin PostgreSQL de Railway.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# NATS es opcional; el backend funciona sin él.
ENABLE_NATS=False

# Por defecto el contenedor arranca Core + los 7 módulos.
RUN_MODULES=true
SKIP_MIGRATIONS=false
