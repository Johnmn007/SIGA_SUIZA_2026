# ============================================================
# Variables para el servicio backend en Railway.
# Copiar estos valores en Railway > Service > Variables.
# NO subir un .env real al repositorio.
# ============================================================

# Arranca Core + los 7 módulos dentro del mismo contenedor.
RUN_MODULES=true

# Entorno de producción.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio-de-32-bytes

# Railway inyecta DATABASE_URL al vincular el plugin PostgreSQL.
# No hace falta definir DB_HOST/DB_PORT/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://...

# Inicializa el esquema de negocio (db/schema.sql) si la BD está vacía.
# Si restauras un dump completo, se detecta y no se toca.
AUTO_INIT_DB=true
SKIP_MIGRATIONS=false

# NATS es opcional. Si no hay servicio NATS en Railway, dejar en false.
ENABLE_NATS=false
# NATS_URL=nats://...

# Redis es opcional (caché). Si agregas el plugin Redis, Railway define REDIS_URL.
# REDIS_URL=redis://...

# CORS: dominio del frontend en Vercel.
# Dejar CORS_ORIGIN_REGEX vacío para producción (solo permite los orígenes listados).
CORS_ORIGINS=https://tu-frontend.vercel.app
CORS_ORIGIN_REGEX=

# Puerto: Railway lo inyecta automáticamente en PORT. No definir aquí.
# PORT=8000
