# SIGA Backend - Ejemplo de variables de entorno
# Copiar a .env y completar valores reales. NUNCA commitear el .env real.
APP_NAME=SIGA Core
ENVIRONMENT=development
SECRET_KEY=cambiar-esta-clave-por-una-larga-y-aleatoria
DEBUG=True

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-este-password
DB_NAME=siga_core

MODULES_AUTO_DISCOVER=True
MODULES_VALIDATE_ON_START=True

NATS_URL=nats://localhost:4222
ENABLE_NATS=True

# Redis (el Core usa host/puerto, no REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
