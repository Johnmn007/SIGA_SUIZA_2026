# Core Configuration
APP_NAME=SIGA Core
ENVIRONMENT=development
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True

# Database (Solo para Identity del Core)
# Dentro de Docker Compose usa el host "postgres"; en local usa "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=siga_suiza_2026

# Module Discovery
MODULES_AUTO_DISCOVER=True
MODULES_VALIDATE_ON_START=True

# NATS Event Bus
NATS_URL=nats://localhost:4222
ENABLE_NATS=False
