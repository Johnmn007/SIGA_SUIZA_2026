# Git en Windows (core.autocrlf=true) converts LF -> CRLF al hacer checkout.
# Los scripts de shell deben conservar LF: con CRLF el shebang no se reconoce
# y Docker falla con "exec ./entrypoint.sh: no such file or directory".
* text=auto

*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.env text eol=lf

*.py text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
